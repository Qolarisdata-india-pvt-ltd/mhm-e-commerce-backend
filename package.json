{
  "name": "mhm-e-commerce-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Run microservices from this root folder",
  "scripts": {
    "dev": "npm-run-all --parallel dev:user dev:product dev:cart dev:order dev:admin dev:vendor dev:gateway",
    "dev:user": "npm run dev --prefix user-service",
    "dev:product": "npm run dev --prefix product-service",
    "dev:cart": "npm run dev --prefix cart-service",
    "dev:order": "npm run dev --prefix order-service",
    "dev:admin": "npm run dev --prefix admin-service",
    "dev:vendor": "npm run dev --prefix vendor-service",
    "dev:gateway": "npm run dev --prefix api-gateway",
    "start": "npm run dev"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
