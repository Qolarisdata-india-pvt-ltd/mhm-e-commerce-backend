PORT=5007
NODE_ENV=production

# Single origin, or use FRONTEND_URLS for multiple (comma-separated)
FRONTEND_URL=https://shop-staging.example.com
# FRONTEND_URLS=https://shop-staging.example.com,https://www.shop-staging.example.com

USER_SERVICE_URL=http://user-service:5001
PRODUCT_SERVICE_URL=http://product-service:5002
CART_SERVICE_URL=http://cart-service:5003
ORDER_SERVICE_URL=http://order-service:5004
ADMIN_SERVICE_URL=http://admin-service:5005
VENDOR_SERVICE_URL=http://vendor-service:5006
VENDOR_SERVICE_ADMIN_URL=http://vendor-service:5006
ADDRESS_SERVICE_URL=http://user-service:5001

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Optional: comma-separated IPs that skip auth rate limit (leave empty in staging)
RATE_LIMIT_TRUSTED_IPS=
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
PROXY_TIMEOUT_MS=10000
